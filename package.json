{
  "name": "sistema-estoque",
  "version": "1.0.1",
  "description": "Sistema de gestão de estoque",
  "main": "main.js",
  "author": "Kahuã Vinicius",
  "scripts": {
    "start": "node backend/server.js",
    "electron": "electron .",
    "build": "electron-builder --win"
},
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "30.0.9",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sistema.estoque",
    "productName": "Sistema de Estoque",
    "files": [
      "main.js",
      "backend/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
