{
  "name": "sistema-estoque",
  "version": "1.1.0",
  "description": "Sistema de gestão de estoque",
  "main": "main.js",
  "author": "Kahuã Vinicius",
  "scripts": {
    "electron": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "30.0.9",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sistema.estoque",
    "productName": "Sistema de Estoque",
    "files": [
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}